---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Experience - Zakher Bouragaoui">
  <Header />
  <main>
    <div class="container">
      <!-- Page Title -->
      <section>
        <h1>Experience</h1>
        <p class="tagline">6+ years advancing conservation through science and strategy</p>
      </section>

      <hr />

      <!-- Current Role Highlight -->
      <section>
        <div class="current-role card">
          <div class="current-badge">CURRENT POSITION</div>
          <h2 class="role-title">M&E and Knowledge Transfer Officer</h2>
          <div class="role-meta">
            <span class="organization">WWF North Africa</span>
            <span class="separator">·</span>
            <span class="period">2024 - Present</span>
            <span class="separator">·</span>
            <span class="location">Tunis, Tunisia</span>
          </div>
          <div class="role-description">
            <p>
              Leading monitoring, evaluation, and knowledge management initiatives across WWF North Africa's 
              conservation portfolio. Developing strategic M&E frameworks, coordinating stakeholder engagement, 
              and ensuring evidence-based program implementation across the region.
            </p>
          </div>
          <div class="key-responsibilities">
            <h3>Key Responsibilities</h3>
            <div class="responsibility-grid">
              <div class="responsibility-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 11 12 14 22 4"></polyline>
                  <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
                <span>Design and implement M&E systems for conservation programs</span>
              </div>
              <div class="responsibility-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 11 12 14 22 4"></polyline>
                  <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
                <span>Coordinate stakeholder engagement and knowledge sharing</span>
              </div>
              <div class="responsibility-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 11 12 14 22 4"></polyline>
                  <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
                <span>Develop strategic frameworks for regional conservation initiatives</span>
              </div>
              <div class="responsibility-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 11 12 14 22 4"></polyline>
                  <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
                <span>Analyze program data and prepare impact reports</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <hr />

      <!-- Professional Timeline -->
      <section>
        <h2>PROFESSIONAL TIMELINE</h2>
        <div class="timeline">
          
          <!-- WWF Conservation Project Officer -->
          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="marker-dot"></div>
              <div class="marker-line"></div>
            </div>
            <div class="timeline-content card">
              <div class="timeline-header">
                <div class="timeline-info">
                  <h3>Conservation Project Officer</h3>
                  <p class="company">WWF North Africa</p>
                </div>
                <div class="timeline-meta">
                  <span class="period">2024</span>
                  <span class="location">Tunis, Tunisia</span>
                </div>
              </div>
              <p class="timeline-description">
                Coordinated implementation of conservation projects focusing on North African ecosystems. 
                Managed project activities, budget tracking, and partner coordination.
              </p>
              <div class="skills-tags">
                <span>Project Management</span>
                <span>Budget Coordination</span>
                <span>Partner Relations</span>
              </div>
            </div>
          </div>

          <!-- Anza-Borrego -->
          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="marker-dot"></div>
              <div class="marker-line"></div>
            </div>
            <div class="timeline-content card">
              <div class="timeline-header">
                <div class="timeline-info">
                  <h3>Wildlife Biologist & Data Analyst</h3>
                  <p class="company">Anza-Borrego Foundation & Institute</p>
                </div>
                <div class="timeline-meta">
                  <span class="period">2023</span>
                  <span class="location">California, USA</span>
                </div>
              </div>
              <p class="timeline-description">
                Conducted comprehensive biodiversity assessments in California desert ecosystems. 
                Performed ecological monitoring, species surveys, and data analysis for conservation planning.
              </p>
              <div class="achievements">
                <h4>Key Achievements</h4>
                <ul>
                  <li>Completed extensive field surveys across desert habitats</li>
                  <li>Analyzed biodiversity data for conservation prioritization</li>
                  <li>Contributed to Anza-Borrego Desert State Park conservation strategies</li>
                </ul>
              </div>
              <div class="skills-tags">
                <span>Field Ecology</span>
                <span>Desert Ecosystems</span>
                <span>Species Surveys</span>
                <span>Data Analysis</span>
              </div>
            </div>
          </div>

          <!-- UW-Madison -->
          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="marker-dot"></div>
              <div class="marker-line"></div>
            </div>
            <div class="timeline-content card">
              <div class="timeline-header">
                <div class="timeline-info">
                  <h3>Graduate Research Assistant</h3>
                  <p class="company">University of Wisconsin-Madison</p>
                </div>
                <div class="timeline-meta">
                  <span class="period">2021 - 2023</span>
                  <span class="location">Wisconsin, USA</span>
                </div>
              </div>
              <p class="timeline-description">
                Conducted innovative research on machine learning applications in wildlife ecology. 
                Developed ML models using bioacoustics for automated bird species identification and 
                ecological monitoring in Sierra Nevada ecosystems.
              </p>
              <div class="achievements">
                <h4>Research Contributions</h4>
                <ul>
                  <li>Developed bioacoustic ML models for automated species identification</li>
                  <li>Conducted species richness modeling in Sierra Nevada</li>
                  <li>Published research on acoustic monitoring methodologies</li>
                  <li>Presented findings at regional and national conferences</li>
                </ul>
              </div>
              <div class="skills-tags">
                <span>Machine Learning</span>
                <span>Bioacoustics</span>
                <span>R Programming</span>
                <span>Python</span>
                <span>Scientific Writing</span>
              </div>
            </div>
          </div>

          <!-- Exploralis -->
          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="marker-dot"></div>
              <div class="marker-line"></div>
            </div>
            <div class="timeline-content card">
              <div class="timeline-header">
                <div class="timeline-info">
                  <h3>Scientific Assistant</h3>
                  <p class="company">Exploralis</p>
                </div>
                <div class="timeline-meta">
                  <span class="period">2019 - 2020</span>
                  <span class="location">Tunisia</span>
                </div>
              </div>
              <p class="timeline-description">
                Supported ecological research and environmental education initiatives. 
                Conducted field surveys and contributed to biodiversity documentation projects.
              </p>
              <div class="skills-tags">
                <span>Field Research</span>
                <span>Environmental Education</span>
                <span>Survey Methods</span>
              </div>
            </div>
          </div>

          <!-- Sea Turtle Conservation -->
          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="marker-dot"></div>
              <div class="marker-line"></div>
            </div>
            <div class="timeline-content card">
              <div class="timeline-header">
                <div class="timeline-info">
                  <h3>Sea Turtle Field Coordinator</h3>
                  <p class="company">Notre Grand Bleu & ATVS</p>
                </div>
                <div class="timeline-meta">
                  <span class="period">2018 - 2019</span>
                  <span class="location">Tunisia</span>
                </div>
              </div>
              <p class="timeline-description">
                Led loggerhead sea turtle (<em>Caretta caretta</em>) monitoring and conservation program. 
                Coordinated field teams, managed nesting beach surveys, and implemented protection protocols.
              </p>
              <div class="achievements">
                <h4>Conservation Impact</h4>
                <ul>
                  <li>Coordinated nesting beach monitoring across Tunisian coastline</li>
                  <li>Trained and supervised field volunteers and researchers</li>
                  <li>Documented nesting activity and implemented nest protection measures</li>
                  <li>Contributed to regional sea turtle conservation strategies</li>
                </ul>
              </div>
              <div class="skills-tags">
                <span>Marine Conservation</span>
                <span>Team Coordination</span>
                <span>Field Surveys</span>
                <span>Volunteer Management</span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <hr />

      <!-- Leadership & Volunteer Experience -->
      <section>
        <h2>LEADERSHIP & VOLUNTEERING</h2>
        <div class="leadership-section">
          <div class="leadership-card card">
            <div class="leadership-header">
              <div class="leadership-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div class="leadership-info">
                <h3>Co-founder & Vice President</h3>
                <p class="org-name">Association Tunisienne de la Vie Sauvage (ATVS)</p>
                <span class="period">2017 - 2023</span>
              </div>
            </div>
            <div class="leadership-description">
              <p>
                Co-founded and led Tunisia's premier wildlife conservation NGO, growing it from inception 
                to become a recognized voice in Mediterranean conservation. Directed strategic planning, 
                coordinated research initiatives, and built partnerships with national and international organizations.
              </p>
            </div>
            <div class="leadership-achievements">
              <h4>Major Accomplishments</h4>
              <div class="achievement-grid">
                <div class="achievement-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                  </svg>
                  <span>Established research programs on endemic species</span>
                </div>
                <div class="achievement-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                  </svg>
                  <span>Coordinated field research on Galite Archipelago</span>
                </div>
                <div class="achievement-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                  </svg>
                  <span>Built partnerships with WWF, IUCN, and regional institutions</span>
                </div>
                <div class="achievement-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                  </svg>
                  <span>Published 10+ scientific papers on Tunisian biodiversity</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <hr />

      <!-- Core Competencies -->
      <section>
        <h2>CORE COMPETENCIES</h2>
        <div class="competencies-grid">
          <div class="competency-card">
            <div class="competency-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
            <h3>Program Management</h3>
            <p>M&E frameworks, strategic planning, stakeholder engagement, budget coordination</p>
          </div>

          <div class="competency-card">
            <div class="competency-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M2 12h20"></path>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <h3>Field Research</h3>
            <p>Ecological surveys, biodiversity assessment, species monitoring, habitat analysis</p>
          </div>

          <div class="competency-card">
            <div class="competency-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="20" x2="12" y2="10"></line>
                <line x1="18" y1="20" x2="18" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="16"></line>
              </svg>
            </div>
            <h3>Data Analysis</h3>
            <p>Statistical modeling, GIS, machine learning, data visualization, R/Python</p>
          </div>

          <div class="competency-card">
            <div class="competency-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <h3>Scientific Communication</h3>
            <p>Technical writing, peer-reviewed publications, presentations, grant proposals</p>
          </div>
        </div>
      </section>

    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* ===========================
     PAGE HEADER
     =========================== */
  .tagline {
    font-size: 1rem !important;
    opacity: 0.7 !important;
    font-style: italic;
    margin-top: -1rem;
  }

  /* ===========================
     CURRENT ROLE HIGHLIGHT
     =========================== */
  .current-role {
    padding: 2rem;
    background: rgba(234, 179, 8, 0.03);
    border-color: var(--accent);
  }

  .current-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--accent);
    color: var(--background);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .role-title {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    padding: 0;
    text-align: left;
  }

  .role-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .organization {
    color: var(--accent);
    font-weight: 600;
    font-size: 1rem;
  }

  .separator {
    opacity: 0.3;
  }

  .period,
  .location {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .role-description p {
    font-size: 1.125rem !important;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .key-responsibilities h3 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    opacity: 0.7;
  }

  .responsibility-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.75rem;
  }

  .responsibility-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .responsibility-item svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--accent);
  }

  .responsibility-item span {
    font-size: 0.9375rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  /* ===========================
     TIMELINE
     =========================== */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.5rem;
  }

  .marker-dot {
    width: 12px;
    height: 12px;
    background: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .marker-line {
    width: 2px;
    flex-grow: 1;
    background: var(--border-color);
    margin-top: 0.5rem;
  }

  .timeline-item:last-child .marker-line {
    display: none;
  }

  .timeline-content {
    padding: 1.5rem;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .timeline-info h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .company {
    font-size: 1rem !important;
    color: var(--accent);
    opacity: 0.9 !important;
    font-weight: 500;
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    text-align: right;
  }

  .timeline-description {
    font-size: 0.9375rem !important;
    line-height: 1.7;
    opacity: 0.85 !important;
    margin-bottom: 1rem;
  }

  .achievements {
    margin: 1.5rem 0;
    padding: 1rem;
    background: rgba(212, 212, 216, 0.03);
    border-left: 3px solid var(--accent);
  }

  .achievements h4 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
    opacity: 0.7;
  }

  .achievements ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .achievements li {
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.85;
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    position: relative;
  }

  .achievements li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .skills-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .skills-tags span {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: rgba(234, 179, 8, 0.1);
    color: var(--accent);
    border-radius: 0.25rem;
    border: 1px solid rgba(234, 179, 8, 0.3);
    font-family: var(--font-mono);
  }

  /* ===========================
     LEADERSHIP SECTION
     =========================== */
  .leadership-card {
    padding: 2rem;
  }

  .leadership-header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .leadership-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(234, 179, 8, 0.1);
    border-radius: 0.5rem;
    border: 1px solid var(--accent);
  }

  .leadership-icon svg {
    color: var(--accent);
  }

  .leadership-info h3 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .org-name {
    font-size: 1rem !important;
    color: var(--accent);
    opacity: 0.9 !important;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .leadership-info .period {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .leadership-description p {
    font-size: 1rem !important;
    line-height: 1.7;
    opacity: 0.85 !important;
    margin-bottom: 1.5rem;
  }

  .leadership-achievements h4 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    opacity: 0.7;
  }

  .achievement-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0.75rem;
  }

  .achievement-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .achievement-item svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--accent);
  }

  .achievement-item span {
    font-size: 0.9375rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  /* ===========================
     COMPETENCIES GRID
     =========================== */
  .competencies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .competency-card {
    text-align: center;
    padding: 1.5rem;
    background: rgba(212, 212, 216, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    transition: all var(--transition-fast);
  }

  .competency-card:hover {
    border-color: var(--accent);
    background: rgba(234, 179, 8, 0.03);
  }

