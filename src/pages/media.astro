---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Media data organized by type
const mediaData = {
  featured: {
    title: 'National Geographic Explorer',
    subtitle: 'Tunisian Wonders Project',
    year: '2023',
    description: 'Featured conservation storytelling initiative documenting Tunisia\'s biodiversity through multimedia narratives and field expeditions.',
    link: 'https://www.nationalgeographic.com'
  },

  videos: [
    {
      title: 'TEDx Talk: The soundtrack of the wild',
      platform: 'TEDxPasha Street',
      date: '2024-10-15',
      duration: '15 min',
      type: 'Talk',
      description: 'In his TEDxPasha Street talk, wildlife ecologist and National Geographic Explorer Zakher Bouragaoui delves into the innovative field of bioacoustics.',
      embedUrl: 'https://www.youtube.com/embed/r8EZ-41vRXc',
      link: 'https://www.youtube.com/watch?v=r8EZ-41vRXc&t=436s'
    },
    {
      title: 'National Geographic Explorer Festival',
      platform: 'National Geographic',
      date: '2025-11-24',
      duration: '4 min',
      type: 'Talk',
      description: 'Zakher Bouragaoui - Spotlight - 2025 Ex Fest Johannesburg.',
      embedUrl: 'https://player.vimeo.com/video/1140112083?h=47dbb8c9d2',
      link: 'https://vimeo.com/1140112083/47dbb8c9d2'
    },
    {
      title: 'Wildlife Wonders',
      platform: 'YouTube',
      date: '2025-03-19',
      duration: '27 min',
      type: 'Documentary',
      description: 'This documentary was made possible through the collective efforts of scientists, conservationists, and organizations dedicated to preserving Tunisia’s natural heritage.',
      embedUrl: 'https://www.youtube.com/embed/oBRHiGLC0S4',
      link: 'https://www.youtube.com/watch?v=oBRHiGLC0S4&t=137s'
    },
    {
      title: 'Un autre regard sur la Medjerda',
      platform: 'YouTube',
      date: '2023-06-01',
      duration: '60 min',
      type: 'Documentary',
      description: 'Field research insights and technological applications in conservation biology.',
      embedUrl: 'https://www.youtube.com/embed/78Yqr9vsHfc',
      link: 'https://www.youtube.com/watch?v=78Yqr9vsHfc&t=234s'
    }
  ],

  audio: [
    {
      title: 'Ecologia Episode 44-A different way to manage natural reserves in Tunisia | With M.Zakher Bouragouai',
      platform: 'Ecologia Podcast',
      date: '2024-01-10',
      duration: '56 min',
      type: 'Podcast',
      description: 'What if we imagined different and innovative ways to manage our natural reserves?',
      link: 'https://www.youtube.com/watch?v=z1gBJx8Z5xc&t=150s'
    },
    {
      title: 'Ecologia Episode 3 - Biodiversity extinction | With Mr. Zakher Bouragaoui',
      platform: 'Ecologia Podcast',
      date: '2021-10-19',
      duration: '25 min',
      type: 'Podcast',
      description: 'What are the challenges facing biodiversity?',
      link: 'https://podcast.com/episode2'
    },
    {
      title: 'الحرائق في الغابات: علم النار و التغيرات المناخية | EP03',
      platform: 'Green Cast',
      date: '2024-06-10',
      duration: '61 min',
      type: 'Podcast',
      description: 'Les flammes d’un incendie nous paraissent terrifiantes, mais ce n’est pas toujours le cas. Incendies de forêt, changement climatique, tout cela et plus encore dans notre nouvel épisode de Greencast.',
      link: 'https://www.youtube.com/watch?v=bZj7KPaG7VU&list=PLIanLHoAMPFeBlnsKjkqz0AQkj9E6YArk&index=2'
    },
    {
      title: 'A New Era for Biodiversity Conservation in Tunisia',
      platform: 'Linnean Society',
      date: '2023-03-17',
      duration: '58 min',
      type: 'Presentation',
      description: 'Tunisia is a hotspot for cultural diversity, a unique region forged by successive civilizations that once flourished in the most northern country of Africa; from Phoenicians to Carthaginians and Amazigh to Arabs.',
      link: 'https://www.youtube.com/watch?v=n_vTCahPxhM&t=1440s'
    }
  ],

  articles: [
    {
      title: 'WWF North Africa Announces New M&E Framework',
      publication: 'WWF Press Room',
      date: '2024-11-15',
      type: 'Press Release',
      description: 'Innovative monitoring and evaluation framework to strengthen conservation programs across the region.',
      link: 'https://wwf.org/press/article1'
    },
    {
      title: 'Fulbright Scholar Advances Wildlife Conservation Technology',
      publication: 'U.S. Embassy Tunisia',
      date: '2023-05-20',
      type: 'Feature Article',
      description: 'Research on machine learning applications in bioacoustic monitoring recognized for innovation.',
      link: 'https://embassy.gov/article1'
    },
    {
      title: 'New Research Reveals Critical Wetland Biodiversity',
      publication: 'Science Daily',
      date: '2024-02-10',
      type: 'Research Highlight',
      description: 'Comprehensive study maps species diversity across southern Tunisia\'s continental wetlands.',
      link: 'https://sciencedaily.com/article1'
    },
    {
      title: 'Machine Learning Transforms Conservation Monitoring',
      publication: 'Nature Conservation',
      date: '2023-11-30',
      type: 'Commentary',
      description: 'The potential and challenges of AI-driven approaches in biodiversity assessment.',
      link: 'https://nature.com/article1'
    }
  ]
};
---

<Layout title="Media - Zakher Bouragaoui">
  <Header />
  <main>
    <div class="container">
      <section>
        <h1>Media</h1>
      </section>


      <!-- Videos Section -->
      <section>
        <h2 class="section-title">Videos & Talks</h2>
        <div class="videos-container">
          {mediaData.videos.map(video => (
            <div class="video-card">
              {video.embedUrl ? (
                <div class="video-embed">
                  <iframe
                    src={video.embedUrl}
                    frameborder="0"
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen
                    title={video.title}
                  ></iframe>
                </div>
              ) : (
                <div class="video-placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                  <span>Video Available</span>
                </div>
              )}
              <div class="video-info">
                <div class="card-header">
                  <span class="media-type">{video.type}</span>
                  <span class="media-date">
                    {new Date(video.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  </span>
                </div>
                <h3>{video.title}</h3>
                <p class="media-platform">{video.platform} · {video.duration}</p>
                <p class="media-description">{video.description}</p>
                <a href={video.link} target="_blank" class="media-link">
                  Watch Full Video →
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <hr />

      <!-- Audio Section -->
      <section>
        <h2 class="section-title">Podcasts & Radio</h2>
        <div class="media-grid">
          {mediaData.audio.map(audio => (
            <div class="media-card">
              <div class="card-header">
                <span class="media-type">{audio.type}</span>
                <span class="media-date">
                  {new Date(audio.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                </span>
              </div>
              <h3>{audio.title}</h3>
              <p class="media-platform">{audio.platform} · {audio.duration}</p>
              <p class="media-description">{audio.description}</p>
              <a href={audio.link} target="_blank" class="media-link">
                Listen →
              </a>
            </div>
          ))}
        </div>
      </section>

      <hr />


    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Featured Highlight */
  .featured-highlight {
    position: relative;
    margin-bottom: 3rem;
    padding: 2rem;
    background: rgba(234, 179, 8, 0.03);
    border: 2px solid var(--accent);
    border-radius: 0.5rem;
  }

  .featured-label {
    position: absolute;
    top: -0.75rem;
    left: 2rem;
    background: var(--background);
    padding: 0.25rem 1rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .featured-content {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 2rem;
    align-items: start;
  }

  .featured-left {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .year-badge {
    display: inline-block;
    width: fit-content;
    padding: 0.25rem 0.75rem;
    background: var(--accent);
    color: var(--background);
    font-size: 0.875rem;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .featured-left h2 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0;
  }

  .featured-left .subtitle {
    font-size: 1.125rem !important;
    color: var(--accent);
    opacity: 0.9 !important;
    margin: 0;
  }

  .featured-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .featured-right p {
    font-size: 1rem !important;
    line-height: 1.7;
    opacity: 0.85 !important;
    margin: 0;
  }

  .btn-explore {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: var(--background);
    font-weight: 600;
    font-size: 1rem;
    width: fit-content;
    transition: all var(--transition-fast);
  }

  .btn-explore:hover {
    background: var(--foreground);
    transform: translateX(4px);
  }

  /* Section Titles */
  .section-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--accent);
    color: var(--accent);
  }

  /* Videos Container */
  .videos-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .video-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    padding: 1.5rem;
    background: rgba(212, 212, 216, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    transition: all var(--transition-fast);
  }

  .video-card:hover {
    border-color: var(--accent);
    background: rgba(234, 179, 8, 0.03);
  }

  /* Video Embed */
  .video-embed {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    background: #000;
    border-radius: 0.25rem;
    overflow: hidden;
  }

  .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Video Placeholder (for videos without embed) */
  .video-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    background: rgba(212, 212, 216, 0.05);
    border: 2px dashed var(--border-color);
    border-radius: 0.25rem;
    color: var(--foreground);
    opacity: 0.5;
    gap: 1rem;
  }

  .video-placeholder svg {
    color: var(--accent);
  }

  .video-placeholder span {
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Video Info */
  .video-info {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .media-type {
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 600;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .media-date {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    opacity: 0.6;
  }

  .video-info h3 {
    font-size: 1.375rem;
    line-height: 1.3;
    margin: 0;
  }

  .media-platform {
    font-size: 0.9375rem !important;
    color: var(--accent);
    opacity: 0.9 !important;
    margin: 0;
  }

  .media-description {
    font-size: 0.9375rem !important;
    line-height: 1.6;
    opacity: 0.75 !important;
    margin: 0;
    flex: 1;
  }

  .media-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    margin-top: 0.5rem;
    width: fit-content;
    transition: all var(--transition-fast);
  }

  .media-link:hover {
    transform: translateX(4px);
  }

  /* Regular Media Grid (for audio and articles) */
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .media-card {
    padding: 1.75rem;
    background: rgba(212, 212, 216, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 0.25rem;
    transition: all var(--transition-fast);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .media-card:hover {
    border-color: var(--accent);
    background: rgba(234, 179, 8, 0.03);
    transform: translateY(-2px);
  }

  .media-card h3 {
    font-size: 1.125rem;
    line-height: 1.4;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .featured-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .video-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .media-grid {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .featured-highlight {
      padding: 1.5rem;
    }

    .featured-left h2 {
      font-size: 1.5rem;
    }

    .video-card {
      padding: 1.25rem;
    }

    .video-info h3 {
      font-size: 1.125rem;
    }

    .media-grid {
      grid-template-columns: 1fr;
    }

    .media-card {
      padding: 1.5rem;
    }
  }
</style>