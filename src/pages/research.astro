---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Research - Zakher Bouragaoui">
  <Header />
  <main>
    <div class="container">
      <!-- Page Title -->
      <section>
        <h1>Research</h1>
        <p class="tagline">Integrating technology, ecology, and conservation science</p>
      </section>

      <hr />

      <!-- Research Overview -->
      <section>
        <h2>RESEARCH FOCUS</h2>
        <div class="focus-grid">
          <div class="focus-card card">
            <div class="focus-number">01</div>
            <h3>Biodiversity Monitoring</h3>
            <p>
              Developing and implementing comprehensive monitoring frameworks for Mediterranean 
              and North African ecosystems, with emphasis on wetlands, islands, and coastal zones.
            </p>
          </div>

          <div class="focus-card card">
            <div class="focus-number">02</div>
            <h3>Technology Integration</h3>
            <p>
              Applying machine learning, bioacoustics, and remote sensing technologies to 
              advance wildlife monitoring, species identification, and ecological research.
            </p>
          </div>

          <div class="focus-card card">
            <div class="focus-number">03</div>
            <h3>Conservation Science</h3>
            <p>
              Translating research findings into actionable conservation strategies through 
              evidence-based approaches and stakeholder engagement.
            </p>
          </div>
        </div>
      </section>

      <hr />

      <!-- Featured Research Projects -->
      <section>
        <h2>RESEARCH PROJECTS</h2>
        
        <!-- Project 1: ML for Birds -->
        <div class="project-card card featured">
          <div class="project-header">
            <div class="project-badge featured-badge">FEATURED</div>
            <div class="project-meta">
              <span class="institution">University of Wisconsin-Madison</span>
              <span class="separator">·</span>
              <span class="period">2021 - 2023</span>
            </div>
          </div>
          <h3>Machine Learning for Bird Species Identification</h3>
          <p class="project-description">
            Developed innovative machine learning models using bioacoustic data for automated 
            bird species identification in Sierra Nevada ecosystems. This research advances 
            non-invasive monitoring techniques and enables large-scale biodiversity assessment.
          </p>
          <div class="project-details">
            <div class="detail-section">
              <h4>Methodology</h4>
              <ul>
                <li>Collected and processed acoustic recordings from multiple field sites</li>
                <li>Developed ML classification algorithms for species identification</li>
                <li>Conducted species richness modeling across elevational gradients</li>
                <li>Validated models through field verification and expert review</li>
              </ul>
            </div>
            <div class="detail-section">
              <h4>Key Outcomes</h4>
              <ul>
                <li>Successfully identified 50+ bird species from acoustic data</li>
                <li>Achieved 85%+ accuracy in automated species classification</li>
                <li>Published methodology in peer-reviewed literature</li>
                <li>Presented findings at regional and national conferences</li>
              </ul>
            </div>
          </div>
          <div class="project-tags">
            <span>Machine Learning</span>
            <span>Bioacoustics</span>
            <span>Species Identification</span>
            <span>Biodiversity Monitoring</span>
            <span>Python</span>
            <span>R</span>
          </div>
        </div>

        <!-- Project 2: Galite Archipelago -->
        <div class="project-card card">
          <div class="project-header">
            <div class="project-badge">FIELD RESEARCH</div>
            <div class="project-meta">
              <span class="institution">ATVS / Initiative PIM</span>
              <span class="separator">·</span>
              <span class="period">2020</span>
            </div>
          </div>
          <h3>Galite Archipelago Lacertidae Study</h3>
          <p class="project-description">
            Comprehensive investigation of endemic lizard species populations in the Galite 
            Archipelago, focusing on population dynamics, habitat characteristics, and 
            conservation priorities for Mediterranean island biodiversity.
          </p>
          <div class="project-details">
            <div class="detail-section">
              <h4>Research Activities</h4>
              <ul>
                <li>Conducted field surveys across multiple islands in the archipelago</li>
                <li>Documented population densities and distribution patterns</li>
                <li>Analyzed habitat preferences and microhabitat utilization</li>
                <li>Assessed threats and developed conservation recommendations</li>
              </ul>
            </div>
          </div>
          <div class="project-tags">
            <span>Island Biogeography</span>
            <span>Reptile Ecology</span>
            <span>Field Surveys</span>
            <span>Conservation Planning</span>
          </div>
        </div>

        <!-- Project 3: Wetlands Biodiversity -->
        <div class="project-card card">
          <div class="project-header">
            <div class="project-badge ongoing-badge">ONGOING</div>
            <div class="project-meta">
              <span class="institution">WWF North Africa</span>
              <span class="separator">·</span>
              <span class="period">2024 - Present</span>
            </div>
          </div>
          <h3>Continental Wetlands Biodiversity Assessment</h3>
          <p class="project-description">
            Synthesizing biodiversity knowledge across continental wetlands in southern Tunisia, 
            documenting species assemblages, and establishing monitoring protocols for long-term 
            conservation management.
          </p>
          <div class="project-details">
            <div class="detail-section">
              <h4>Research Components</h4>
              <ul>
                <li>Comprehensive literature review and data compilation</li>
                <li>Field surveys of waterbird populations and diversity</li>
                <li>Habitat characterization and threat assessment</li>
                <li>Development of monitoring and management frameworks</li>
              </ul>
            </div>
          </div>
          <div class="project-tags">
            <span>Wetland Ecology</span>
            <span>Biodiversity Assessment</span>
            <span>Waterbirds</span>
            <span>Conservation Management</span>
          </div>
        </div>

        <!-- Project 4: Lacertid Ecology -->
        <div class="project-card card">
          <div class="project-header">
            <div class="project-badge">COMPLETED</div>
            <div class="project-meta">
              <span class="institution">Faculty of Sciences of Tunis</span>
              <span class="separator">·</span>
              <span class="period">2016 - 2018</span>
            </div>
          </div>
          <h3>Lacertid Lizard Ecology and Diet Analysis</h3>
          <p class="project-description">
            Master's research investigating dietary preferences, age determination, and ecological 
            relationships in Tunisian lacertid lizard populations, contributing to understanding 
            of Mediterranean reptile ecology.
          </p>
          <div class="project-tags">
            <span>Herpetology</span>
            <span>Diet Analysis</span>
            <span>Age Determination</span>
            <span>Population Ecology</span>
          </div>
        </div>

      </section>

      <hr />

      <!-- Recognition & Awards -->
      <section>
        <h2>RESEARCH RECOGNITION</h2>
        <div class="awards-grid">
          <div class="award-card card highlight">
            <div class="award-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="7"></circle>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
              </svg>
            </div>
            <h3>National Geographic Explorer</h3>
            <p class="award-year">2023</p>
            <p class="award-description">
              Selected for biodiversity documentation and conservation storytelling through 
              the <em>Tunisian Wonders</em> project.
            </p>
          </div>

          <div class="award-card card">
            <div class="award-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
            </div>
            <h3>Fulbright Scholarship</h3>
            <p class="award-year">2021</p>
            <p class="award-description">
              Competitive merit-based fellowship for graduate research in wildlife ecology 
              and conservation technology.
            </p>
          </div>

          <div class="award-card card">
            <div class="award-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M2 12h20"></path>
                <circle cx="12" cy="12" r="9"></circle>
              </svg>
            </div>
            <h3>Initiative PIM Grant</h3>
            <p class="award-year">2019</p>
            <p class="award-description">
              Research funding for Mediterranean island conservation and ecological studies.
            </p>
          </div>
        </div>
      </section>

      <hr />

      <!-- Research Interests -->
      <section>
        <h2>RESEARCH INTERESTS</h2>
        <div class="interests-grid">
          
          <div class="interest-card">
            <div class="interest-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l12-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="18" cy="16" r="3"></circle>
              </svg>
            </div>
            <h3>Bioacoustics & Machine Learning</h3>
            <p>
              Developing automated monitoring systems using acoustic data and AI for 
              non-invasive species detection and biodiversity assessment.
            </p>
          </div>

          <div class="interest-card">
            <div class="interest-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2"></circle>
              </svg>
            </div>
            <h3>Island Biogeography</h3>
            <p>
              Understanding species distribution, endemism, and conservation priorities 
              in Mediterranean island ecosystems.
            </p>
          </div>

          <div class="interest-card">
            <div class="interest-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              </svg>
            </div>
            <h3>Wetland Conservation</h3>
            <p>
              Monitoring wetland biodiversity, waterbird populations, and ecosystem 
              health in North African landscapes.
            </p>
          </div>

          <div class="interest-card">
            <div class="interest-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="20" x2="12" y2="10"></line>
                <line x1="18" y1="20" x2="18" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="16"></line>
              </svg>
            </div>
            <h3>Statistical Modeling</h3>
            <p>
              Applying advanced statistical methods for species distribution modeling, 
              population dynamics, and ecological pattern analysis.
            </p>
          </div>

          <div class="interest-card">
            <div class="interest-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
            </div>
            <h3>Reptile Ecology</h3>
            <p>
              Investigating population biology, habitat use, and conservation needs of 
              North African herpetofauna, particularly lacertid lizards.
            </p>
          </div>

          <div class="interest-card">
            <div class="interest-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <h3>Conservation Planning</h3>
            <p>
              Integrating research outcomes into strategic conservation frameworks, 
              protected area management, and policy development.
            </p>
          </div>

        </div>
      </section>

      <hr />

      <!-- Methodological Expertise -->
      <section>
        <h2>METHODOLOGICAL EXPERTISE</h2>
        <div class="methods-grid">
          
          <div class="method-category card">
            <h3>Field Methods</h3>
            <ul>
              <li>Transect and point count surveys</li>
              <li>Mark-recapture techniques</li>
              <li>Acoustic monitoring</li>
              <li>Habitat assessment protocols</li>
              <li>Camera trapping</li>
              <li>Specimen collection and preservation</li>
            </ul>
          </div>

          <div class="method-category card">
            <h3>Analytical Approaches</h3>
            <ul>
              <li>Machine learning & AI applications</li>
              <li>Statistical modeling (GLM, GAM, mixed models)</li>
              <li>Species distribution modeling</li>
              <li>GIS and spatial analysis</li>
              <li>Bioacoustic signal processing</li>
              <li>Population viability analysis</li>
            </ul>
          </div>

          <div class="method-category card">
            <h3>Technical Skills</h3>
            <ul>
              <li>R (advanced proficiency)</li>
              <li>Python (data science & ML)</li>
              <li>SQL (database management)</li>
              <li>QGIS & ArcGIS</li>
              <li>Git version control</li>
              <li>High-performance computing</li>
            </ul>
          </div>

          <div class="method-category card">
            <h3>Laboratory Work</h3>
            <ul>
              <li>Morphometric measurements</li>
              <li>Diet analysis (stomach contents)</li>
              <li>Age determination techniques</li>
              <li>Specimen curation</li>
              <li>Tissue sampling</li>
              <li>Data quality control</li>
            </ul>
          </div>

        </div>
      </section>

      <hr />

      <!-- Collaboration & Resources -->
      <section class="collaboration-section">
        <h2>RESEARCH COLLABORATION</h2>
        <div class="collab-content">
          <p class="collab-text">
            I'm open to research collaborations, data sharing, and partnerships that advance 
            conservation science in Mediterranean and North African ecosystems. Areas of particular 
            interest include technological innovation in monitoring, capacity building, and 
            evidence-based conservation strategy development.
          </p>
          <div class="collab-buttons">
            <a href="/publications" class="button">View Publications</a>
            <a href="/contact" class="button">Discuss Collaboration</a>
          </div>
        </div>
      </section>

    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* ===========================
     PAGE HEADER
     =========================== */
  .tagline {
    font-size: 1rem !important;
    opacity: 0.7 !important;
    font-style: italic;
    margin-top: -1rem;
  }

  /* ===========================
     RESEARCH FOCUS
     =========================== */
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .focus-card {
    padding: 1.5rem;
    position: relative;
  }

  .focus-number {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 2.5rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    opacity: 0.15;
  }

  .focus-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
    color: var(--accent);
  }

  .focus-card p {
    font-size: 0.9375rem !important;
    line-height: 1.6;
    opacity: 0.85 !important;
  }

  /* ===========================
     PROJECT CARDS
     =========================== */
  .project-card {
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .project-card.featured {
    border-color: var(--accent);
    background: rgba(234, 179, 8, 0.02);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .project-badge {
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    border: 1px solid var(--border-color);
    border-radius: 0.25rem;
  }

  .featured-badge {
    background: var(--accent);
    color: var(--background);
    border-color: var(--accent);
  }

  .ongoing-badge {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border-color: #10b981;
  }

  .project-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .institution {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
    opacity: 0.9;
  }

  .separator {
    opacity: 0.3;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .project-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .project-description {
    font-size: 1rem !important;
    line-height: 1.7;
    opacity: 0.85 !important;
    margin-bottom: 1.5rem;
  }

  .project-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .detail-section {
    background: rgba(212, 212, 216, 0.03);
    padding: 1.25rem;
    border-left: 3px solid var(--accent);
  }

  .detail-section h4 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
    opacity: 0.7;
  }

  .detail-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .detail-section li {
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.85;
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    position: relative;
  }

  .detail-section li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .project-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .project-tags span {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: rgba(234, 179, 8, 0.1);
    color: var(--accent);
    border-radius: 0.25rem;
    border: 1px solid rgba(234, 179, 8, 0.3);
    font-family: var(--font-mono);
  }

  /* ===========================
     AWARDS GRID
     =========================== */
  .awards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .award-card {
    padding: 1.5rem;
    text-align: center;
  }

  .award-card.highlight {
    border-color: var(--accent);
    background: rgba(234, 179, 8, 0.02);
  }

  .award-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(234, 179, 8, 0.1);
    border-radius: 0.5rem;
    border: 1px solid var(--border-color);
  }

  .award-card.highlight .award-icon {
    border-color: var(--accent);
  }

  .award-icon svg {
    color: var(--accent);
  }

  .award-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .award-year {
    font-family: var(--font-mono);
    font-size: 0.875rem !important;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.8 !important;
    margin-bottom: 0.75rem;
  }

  .award-description {
    font-size: 0.9375rem !important;
    line-height: 1.6;
    opacity: 0.85 !important;
  }

  .award-description em {
    color: var(--accent);
    font-style: normal;
    font-weight: 500;
  }

  /* ===========================
     RESEARCH INTERESTS
     =========================== */
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .interest-card {
    text-align: center;
    padding: 1.5rem;
  }

  .interest-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--foreground);
    opacity: 0.3;
    transition: all var(--transition-fast);
  }

  .interest-card:hover .interest-icon {
    color: var(--accent);
    opacity: 1;
    transform: scale(1.1);
  }

  .interest-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
    color: var(--accent);
  }

  .interest-card p {
    font-size: 0.9375rem !important;
    line-height: 1.6;
    opacity: 0.85 !important;
  }

  /* ===========================
     METHODOLOGICAL EXPERTISE
     =========================== */
  .methods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .method-category {
    padding: 1.5rem;
  }

  .method-category h3 {
    font-size: 1.125rem;
    margin-bottom: 1rem;
    color: var(--accent);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .method-category ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .method-category li {
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.85;
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    position: relative;
  }

  .method-category li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  /* ===========================
     COLLABORATION SECTION
     =========================== */
  .collaboration-section {
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .collab-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .collab-text {
    font-size: 1.125rem !important;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .collab-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ===========================
     RESPONSIVE DESIGN
     =========================== */
  @media (max-width: 768px) {
    .focus-grid,
    .awards-grid,
    .interests-grid,
    .methods-grid {
      grid-template-columns: 1fr;
    }

    .project-details {
      grid-template-columns: 1fr;
    }

    .project-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .collab-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .button {
      width: 100%;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
