---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About - Zakher Bouragaoui">
  <Header />
  <main>
    <div class="container">

      <!-- Hero Section with Photo -->
      <section class="hero-section">
        <div class="hero-content">
          <h1>About Me</h1>
          <p class="tagline">Conservation biologist bridging science, technology, and policy</p>
        </div>
        <div class="hero-image">
          <img src="/website/images/zakher-photo.png" alt="Zakher Bouragaoui" />
        </div>
      </section>

      <hr />

      <!-- Bio Section -->
      <section>
        <h2>Background</h2>
        <p>
          I am a conservation biologist and data scientist working at the intersection of biodiversity monitoring,
          machine learning, and environmental policy. Currently serving as Monitoring & Evaluation Officer at WWF
          North Africa, I develop evidence-based frameworks to strengthen conservation programs across the region.
        </p>
        <p>
          As a 2022-2023 Fulbright Scholar at UC Davis, I specialized in applying machine learning to bioacoustic
          monitoring for biodiversity assessment. My research combines field ecology with computational methods to
          address critical conservation challenges in North Africa and the Mediterranean.
        </p>
        <p>
          Recognized as a National Geographic Explorer, I have led field expeditions documenting Tunisia's biodiversity,
          from continental wetlands to Mediterranean islands. My work spans herpetology, island biogeography, and
          community-based conservation, always seeking innovative approaches to protect ecosystems and species.
        </p>
      </section>

      <hr />

      <!-- Expertise Grid -->
      <section>
        <h2>Areas of Expertise</h2>
        <div class="expertise-grid">
          <div class="expertise-card">

            <h3>Conservation Biology</h3>
            <p>Biodiversity monitoring, species assessment, and habitat evaluation with emphasis on Mediterranean ecosystems.</p>
          </div>
          <div class="expertise-card">

            <h3>Machine Learning</h3>
            <p>Bioacoustic analysis, species identification algorithms, and data-driven conservation decision-making.</p>
          </div>
          <div class="expertise-card">

            <h3>M&E Frameworks</h3>
            <p>Monitoring and evaluation systems design, impact assessment, and adaptive management strategies.</p>
          </div>
          <div class="expertise-card">

            <h3>Field Research</h3>
            <p>Expedition leadership, ecological surveys, and community engagement in remote locations across North Africa.</p>
          </div>
        </div>
      </section>

      <hr />

      <!-- Current Work -->
      <section>
        <h2>Current Focus</h2>
        <div class="focus-areas">
          <div class="focus-item">
            <h3>WWF North Africa</h3>
            <p>
              Leading the development and implementation of monitoring and evaluation frameworks for conservation
              programs across North Africa. Integrating technology and data science to enhance program effectiveness
              and evidence-based decision-making.
            </p>
          </div>
          <div class="focus-item">
            <h3>Research Interests</h3>
            <p>
              Advancing the application of machine learning in biodiversity monitoring, with particular focus on
              bioacoustic analysis for species detection. Exploring innovative approaches to assess and protect
              Mediterranean island ecosystems and continental wetland biodiversity.
            </p>
          </div>
          <div class="focus-item">
            <h3>Conservation Technology</h3>
            <p>
              Developing accessible tools and methodologies that bridge the gap between cutting-edge technology
              and practical conservation applications, especially in resource-limited contexts.
            </p>
          </div>
        </div>
      </section>

      <hr />

      <!-- Education & Recognition -->
      <section>
        <div class="credentials-grid">
          <div>
            <h2>Education</h2>
            <div class="credential-item">
              <h3>Fulbright Scholar</h3>
              <p>University of California, Davis</p>
              <p class="year">2022-2023</p>
            </div>
            <div class="credential-item">
              <h3>Master's in Biodiversity & Ecosystems</h3>
              <p>University of Tunis El Manar</p>
              <p class="year">2019</p>
            </div>
          </div>
          <div>
            <h2>Recognition</h2>
            <div class="credential-item">
              <h3>National Geographic Explorer</h3>
              <p>Tunisian Wonders Project</p>
              <p class="year">2023</p>
            </div>
            <div class="credential-item">
              <h3>Conservation Leadership</h3>
              <p>WWF North Africa</p>
              <p class="year">2024-Present</p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Hero Section with Photo */
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 3rem;
    align-items: center;
    margin-bottom: 2rem;
  }

  .hero-content h1 {
    margin-bottom: 1rem;
  }

  .tagline {
    font-size: 1.25rem !important;
    color: var(--accent);
    opacity: 0.95 !important;
    line-height: 1.6;
    margin: 0;
  }

  .hero-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 3px solid var(--accent);
    border-radius: 0.5rem;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Expertise Grid */
  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .expertise-card {
    padding: 2rem;
    background: rgba(212, 212, 216, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 0.25rem;
    transition: all var(--transition-fast);
  }

  .expertise-card:hover {
    border-color: var(--accent);
    background: rgba(234, 179, 8, 0.03);
    transform: translateY(-2px);
  }

  .expertise-card .icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .expertise-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--accent);
  }

  .expertise-card p {
    font-size: 0.9375rem !important;
    line-height: 1.6;
    opacity: 0.85 !important;
    margin: 0;
  }

  /* Focus Areas */
  .focus-areas {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .focus-item h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--accent);
  }

  .focus-item p {
    font-size: 1rem !important;
    line-height: 1.7;
    opacity: 0.85 !important;
    margin: 0;
  }

  /* Credentials Grid */
  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
    margin-top: 1.5rem;
  }

  .credential-item {
    padding: 1.5rem;
    background: rgba(212, 212, 216, 0.02);
    border-left: 3px solid var(--accent);
    margin-bottom: 1.5rem;
  }

  .credential-item h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .credential-item p {
    font-size: 0.9375rem !important;
    opacity: 0.85 !important;
    margin: 0.25rem 0;
  }

  .credential-item .year {
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 600;
    margin-top: 0.5rem;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-image {
      max-width: 400px;
      margin: 0 auto;
    }

    .credentials-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .hero-image {
      max-width: 100%;
    }

    .expertise-grid {
      grid-template-columns: 1fr;
    }

    .tagline {
      font-size: 1.125rem !important;
    }
  }
</style>