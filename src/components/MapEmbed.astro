---
interface Props {
  center: [number, number];
  zoom: number;
  route?: string;
  height?: string;
}

const { center, zoom, route, height = '500px' } = Astro.props;
const mapId = `map-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="map-embed" style={`height: ${height}`}>
  <div id={mapId} class="map-container"></div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script define:vars={{ mapId, center, zoom, route }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Initialize map
    const map = L.map(mapId).setView(center, zoom);

    // Add Stadia Maps tile layer
    L.tileLayer('https://tiles.stadiamaps.com/tiles/stamen_terrain/{z}/{x}/{y}{r}.png?api_key=0dd260f5-5612-407b-9334-4574d0146f27', {
      attribution: '&copy; <a href="https://stadiamaps.com/">Stadia Maps</a>, &copy; <a href="https://stamen.com/">Stamen Design</a>, &copy; <a href="https://openmaptiles.org/">OpenMapTiles</a>',
      maxZoom: 18
    }).addTo(map);

    // Load and display route if provided
    if (route) {
      fetch(route)
        .then(response => response.json())
        .then(data => {
          // Add route lines
          const routes = data.features.filter(f => f.properties.type === 'route');
          routes.forEach(route => {
            const coords = route.geometry.coordinates.map(c => [c[1], c[0]]);
            L.polyline(coords, {
              color: '#D4874A',
              weight: 4,
              opacity: 0.8
            }).addTo(map);
          });

          // Add waypoints
          const points = data.features.filter(f => f.properties.type === 'point');
          points.forEach(point => {
            const coords = [point.geometry.coordinates[1], point.geometry.coordinates[0]];
            const name = point.properties.name;

            if (name && name !== 'Unnamed') {
              L.circleMarker(coords, {
                radius: 8,
                fillColor: '#4CAF6A',
                fillOpacity: 0.9,
                color: '#FFF',
                weight: 2
              }).addTo(map).bindPopup(`<strong>${name}</strong>`);
            }
          });

          // Fit bounds to show all features
          const bounds = L.geoJSON(data).getBounds();
          map.fitBounds(bounds, { padding: [50, 50] });
        })
        .catch(error => console.error('Error loading route:', error));
    }
  });
</script>

<style>
  .map-embed {
    position: relative;
    margin: 2rem 0;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid #D4874A;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .map-container {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .map-embed {
      height: 400px !important;
    }
  }
</style>
