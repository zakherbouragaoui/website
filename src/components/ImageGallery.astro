---
interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<div class="image-gallery">
  {images.map((image) => (
    <figure class="gallery-item">
      <img src={image.src} alt={image.alt} loading="lazy" />
      {image.caption && <figcaption>{image.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .image-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: rgba(26, 43, 66, 0.3);
    border: 1px solid rgba(245, 241, 232, 0.1);
    transition: all 0.3s ease;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(212, 135, 74, 0.3);
    border-color: #D4874A;
  }

  .gallery-item img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  figcaption {
    padding: 1rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #C7BEAA;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .image-gallery {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .gallery-item img {
      height: 250px;
    }
  }
</style>
