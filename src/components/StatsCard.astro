---
interface Props {
  value: string;
  label: string;
  icon?: string;
  color?: 'green' | 'orange' | 'blue' | 'purple';
}

const { value, label, icon = '', color = 'green' } = Astro.props;

const colorMap = {
  green: '#4CAF6A',
  orange: '#D4874A',
  blue: '#6B9BD1',
  purple: '#9B6BC8'
};

const bgColor = colorMap[color] || colorMap.green;
---

<div class="stat-card" data-color={color}>
  {icon && <span class="stat-icon">{icon}</span>}
  <span class="stat-value">{value}</span>
  <span class="stat-label">{label}</span>
</div>

<style define:vars={{ bgColor }}>
  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    background: linear-gradient(135deg, rgba(26, 43, 66, 0.6) 0%, rgba(12, 21, 32, 0.8) 100%);
    border: 2px solid var(--bgColor);
    border-radius: 12px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px var(--bgColor);
    border-width: 3px;
  }

  .stat-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .stat-value {
    font-size: 3rem;
    font-weight: 700;
    color: var(--bgColor);
    font-family: 'Courier New', monospace;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #F5F1E8;
    opacity: 0.8;
    text-align: center;
  }

  @media (max-width: 768px) {
    .stat-card {
      padding: 1.5rem 1rem;
    }

    .stat-value {
      font-size: 2.2rem;
    }

    .stat-icon {
      font-size: 2rem;
    }
  }
</style>
