<section id="publications" class="publications">
  <div class="container">
    <h2 class="section-title">Publications</h2>
    <p class="publications-intro">
      A selection of peer-reviewed publications and conference presentations spanning biodiversity conservation, 
      ecological research, and species monitoring across North Africa and beyond.
    </p>
    
    <div class="publications-list">
      {publications.map(yearGroup => (
        <div class="year-section">
          <h3 class="year-header">{yearGroup.year}</h3>
          <div class="publications-year-group">
            {yearGroup.items.map(pub => (
              <div class="publication-card">
                <p class="publication-authors">{pub.authors}</p>
                <p class="publication-title">{pub.title}</p>
                <p class="publication-venue">{pub.venue}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="research-interests">
      <h3 class="subsection-title">Research Interests</h3>
      <div class="interests-grid">
        <div class="interest-card">
          <span class="interest-icon">🦎</span>
          <h4>Reptile Ecology</h4>
          <p>Population dynamics and conservation of Mediterranean lizard species</p>
        </div>
        <div class="interest-card">
          <span class="interest-icon">🔊</span>
