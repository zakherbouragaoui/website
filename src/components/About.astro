<section id="about" class="about">
  <div class="container">
    <h2 class="section-title">About Me</h2>
    <div class="about-content">
      <div class="about-text">
        <p>
          I am a wildlife conservation professional with extensive expertise in biodiversity monitoring, 
          ecological research, and conservation program management. As a Fulbright Scholar, I received 
          advanced training in wildlife ecology and statistical modeling at the University of Wisconsin-Madison.
        </p>
        <p>
          Currently serving as M&E and Knowledge Transfer Officer at WWF North Africa, I lead monitoring 
          and evaluation of conservation programs across the region. My work focuses on developing strategic 
          frameworks, coordinating stakeholder engagement, and translating scientific findings into actionable 
          conservation strategies.
        </p>
        <p>
          My research journey has taken me from the wetlands of Tunisia to the deserts of California, 
          studying everything from Lacertid lizards to loggerhead sea turtles. I'm particularly passionate 
          about using innovative technologies like bioacoustics and machine learning to enhance biodiversity 
          monitoring and conservation outcomes.
        </p>
      </div>
      <div class="about-highlights">
        <div class="highlight-card">
          <div class="highlight-icon">🎓</div>
          <h3>Education</h3>
          <p>M.S. in Wildlife Ecology from University of Wisconsin-Madison</p>
          <p>M.S. in Evolutionary Ecology from Faculty of Sciences of Tunis</p>
        </div>
        <div class="highlight-card">
          <div class="highlight-icon">🏆</div>
          <h3>Recognition</h3>
          <p>National Geographic Explorer (2023)</p>
          <p>Fulbright Master Program Scholar (2021)</p>
        </div>
        <div class="highlight-card">
          <div class="highlight-icon">🌍</div>
          <h3>Impact</h3>
          <p>Leading conservation programs across North Africa</p>
          <p>Published researcher with 15+ scientific publications</p>
        </div>
      </div>
    </div>

    <div class="skills-section">
      <h3 class="subsection-title">Technical Skills</h3>
      <div class="skills-grid">
        <div class="skill-category">
          <h4>Conservation & Research</h4>
          <ul>
            <li>Biodiversity Monitoring</li>
            <li>Field Research Methodology</li>
            <li>Population Ecology</li>
            <li>Conservation Planning</li>
            <li>Ecological Assessment</li>
          </ul>
        </div>
        <div class="skill-category">
          <h4>Technical Tools</h4>
          <ul>
            <li>GIS Analysis</li>
            <li>R Programming</li>
            <li>Python & Machine Learning</li>
            <li>Statistical Modeling</li>
            <li>Species Distribution Modeling</li>
            <li>Bioacoustics Analysis</li>
          </ul>
        </div>
        <div class="skill-category">
          <h4>Design & Visualization</h4>
          <ul>
            <li>Adobe Creative Suite</li>
            <li>Data Visualization</li>
            <li>Scientific Illustration</li>
          </ul>
        </div>
        <div class="skill-category">
          <h4>Languages</h4>
          <ul>
            <li>Arabic (Native)</li>
            <li>English (Fluent)</li>
            <li>French (Fluent)</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-white);
  }

  .section-title {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--color-primary);
    position: relative;
  }

  .section-title::after {
    content: '';
    display: block;
    width: 80px;
    height: 4px;
    background: var(--color-accent);
    margin: 1rem auto 0;
    border-radius: 2px;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .about-text p {
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-gray);
  }

  .about-highlights {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .highlight-card {
    background: var(--color-light-gray);
    padding: 1.5rem;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .highlight-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .highlight-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .highlight-card h3 {
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-size: 1.3rem;
  }

  .highlight-card p {
    color: var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .skills-section {
    margin-top: 4rem;
  }

  .subsection-title {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--color-primary);
    text-align: center;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .skill-category {
    background: var(--color-light-gray);
    padding: 2rem;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .skill-category:hover {
    background: var(--color-primary);
  }

  .skill-category:hover h4,
  .skill-category:hover li {
    color: var(--color-white);
  }

  .skill-category h4 {
    color: var(--color-primary);
    margin-bottom: 1rem;
    font-size: 1.2rem;
  }

  .skill-category ul {
    list-style: none;
  }

  .skill-category li {
    padding: 0.5rem 0;
    color: var(--color-gray);
    position: relative;
    padding-left: 1.5rem;
  }

  .skill-category li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  @media (max-width: 968px) {
    .about-content {
      grid-template-columns: 1fr;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
