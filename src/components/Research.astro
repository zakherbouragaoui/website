---
const researchProjects = [
  {
    title: "Machine Learning for Bird Species Identification",
    institution: "University of Wisconsin-Madison",
    period: "2021 - 2023",
    description: "Developed machine learning models for bird species identification using bioacoustics and acoustic indices. Conducted species richness modeling in Sierra Nevada, California, integrating ecological and environmental data.",
    tags: ["Bioacoustics", "Machine Learning", "Species Modeling"]
  },
  {
    title: "PAD: Investigating Insular Species of Lacertidae in Galite Archipelago",
    institution: "Tunisian Association for Wildlife (ATVS)",
    period: "2020",
    description: "Led investigation of endemic Lacertidae species in Mediterranean island ecosystems. Coordinated field surveys, data collection, and species distribution mapping. Analyzed population dynamics and habitat characteristics of island-endemic lizard species.",
    tags: ["Island Biogeography", "Reptile Ecology", "Population Dynamics"]
  },
  {
    title: "Lacertid Lizard Ecology in Tunisia",
    institution: "Faculty of Sciences of Tunis",
    period: "2016 - 2018",
    description: "Investigated Mediterranean island biogeography and species evolution patterns. Specialized in biodiversity monitoring techniques and statistical analysis of ecological data with focus on Lacertid lizard ecology in Tunisia and Mediterranean islands.",
    tags: ["Evolutionary Ecology", "Biodiversity Monitoring", "Mediterranean Ecosystems"]
  },
  {
    title: "Zembra Island Lizard Population Monitoring",
    institution: "Initiative PIM",
    period: "2019",
    description: "Conducted comprehensive population monitoring of lizard species on Zembra Island. Implemented field protocols for data collection and analyzed population trends in relation to habitat characteristics and environmental variables.",
    tags: ["Conservation Biology", "Population Monitoring", "Island Ecology"]
  }
];

const awards = [
  {
    title: "National Geographic Explorer",
    organization: "National Geographic Society",
    year: "2023",
    description: "Recognized for outstanding contributions to wildlife conservation and biodiversity research through the project 'Tunisian Wonders' focusing on biodiversity documentation."
  },
  {
    title: "Fulbright Master Program Scholar",
    organization: "Fulbright Commission",
    year: "2021",
    description: "Selected for graduate studies in Wildlife Ecology at University of Wisconsin-Madison. Full scholarship covering tuition, living expenses, and research support."
  },
  {
    title: "Research Grant - Initiative PIM, Zembra Island",
    organization: "Initiative PIM",
    year: "2019",
    description: "Funding awarded for lizard population monitoring and island conservation research. Support for field equipment, travel, and publication of research findings."
  }
];
---

<section id="research" class="research">
  <div class="container">
    <h2 class="section-title">Research & Projects</h2>
    
    <div class="research-grid">
      {researchProjects.map(project => (
        <div class="research-card">
          <h3>{project.title}</h3>
          <div class="research-meta">
            <span class="institution">{project.institution}</span>
            <span class="period">{project.period}</span>
          </div>
          <p>{project.description}</p>
          <div class="tags">
            {project.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="awards-section">
      <h3 class="subsection-title">Awards & Recognition</h3>
      <div class="awards-grid">
        {awards.map(award => (
          <div class="award-card">
            <div class="award-header">
              <div class="award-icon">🏆</div>
              <div>
                <h4>{award.title}</h4>
                <p class="award-org">{award.organization}</p>
              </div>
              <span class="award-year">{award.year}</span>
            </div>
            <p class="award-description">{award.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="leadership-section">
      <h3 class="subsection-title">Leadership</h3>
      <div class="leadership-card">
        <h4>Co-founder & Vice-President</h4>
        <p class="leadership-org">Tunisian Association for Wildlife (ATVS)</p>
        <p class="leadership-period">2017 - 2023 | Tunis, Tunisia</p>
        <ul class="leadership-points">
          <li>Provided strategic leadership and organizational direction for wildlife conservation initiatives</li>
          <li>Coordinated research projects, volunteer activities, and conservation advocacy campaigns</li>
          <li>Developed partnerships with national and international conservation organizations</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .research {
    background: var(--color-white);
  }

  .section-title {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--color-primary);
    position: relative;
  }

  .section-title::after {
    content: '';
    display: block;
    width: 80px;
    height: 4px;
    background: var(--color-accent);
    margin: 1rem auto 0;
    border-radius: 2px;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .research-card {
    background: var(--color-light-gray);
    padding: 2rem;
    border-radius: 12px;
    transition: all 0.3s ease;
    border-left: 4px solid var(--color-accent);
  }

  .research-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    border-left-color: var(--color-primary);
  }

  .research-card h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
    font-size: 1.3rem;
    line-height: 1.4;
  }

  .research-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .institution {
    color: var(--color-secondary);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .period {
    color: var(--color-gray);
    font-size: 0.9rem;
  }

  .research-card p {
    color: var(--color-gray);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: var(--color-white);
    color: var(--color-secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .subsection-title {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--color-primary);
    text-align: center;
  }

  .awards-section {
    margin-bottom: 4rem;
  }

  .awards-grid {
    display: grid;
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .award-card {
    background: linear-gradient(135deg, var(--color-light-gray) 0%, #fff 100%);
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }

  .award-card:hover {
    transform: translateX(10px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .award-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .award-icon {
    font-size: 2rem;
  }

  .award-header h4 {
    color: var(--color-primary);
    margin-bottom: 0.25rem;
    font-size: 1.2rem;
  }

  .award-org {
    color: var(--color-secondary);
    font-weight: 600;
    font-size: 0.95rem;
    margin: 0;
  }

  .award-year {
    margin-left: auto;
    background: var(--color-accent);
    color: var(--color-white);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .award-description {
    color: var(--color-gray);
    line-height: 1.6;
  }

  .leadership-section {
    max-width: 800px;
    margin: 0 auto;
  }

  .leadership-card {
    background: var(--color-primary);
    color: var(--color-white);
    padding: 2.5rem;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(45, 80, 22, 0.3);
  }

  .leadership-card h4 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .leadership-org {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    opacity: 0.95;
  }

  .leadership-period {
    opacity: 0.8;
    margin-bottom: 1.5rem;
  }

  .leadership-points {
    list-style: none;
  }

  .leadership-points li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    line-height: 1.6;
  }

  .leadership-points li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
    font-size: 1.2rem;
  }

  @media (max-width: 768px) {
    .research-grid {
      grid-template-columns: 1fr;
    }

    .award-header {
      flex-wrap: wrap;
    }

    .award-year {
      margin-left: 0;
    }
  }
</style>
