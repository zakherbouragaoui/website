---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Conservation biologist specializing in biodiversity monitoring and ecological research" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ===========================
     RESET & BOX SIZING
     =========================== */
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* ===========================
     CSS VARIABLES (Exact Ryze Dark Theme)
     =========================== */
  :root {
    /* Exact Tailwind Colors from Ryze */
    --color-zinc-800: #27272a;
    --color-zinc-300: #d4d4d8;
    --color-yellow-500: #eab308;
    
    /* Theme Variables */
    --background: var(--color-zinc-800);
    --foreground: var(--color-zinc-300);
    --accent: var(--color-yellow-500);
    
    /* Typography */
    --font-sans: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'IBM Plex Mono', 'Courier New', monospace;
    
    /* Opacity values for text hierarchy */
    --opacity-full: 1;
    --opacity-high: 0.9;
    --opacity-medium: 0.7;
    --opacity-low: 0.5;
    
    /* Borders */
    --border-color: rgba(212, 212, 216, 0.16);
    --border-color-hover: var(--accent);
    
    /* Transitions */
    --transition-fast: 150ms ease-in-out;
    --transition-medium: 250ms ease-in-out;
  }

  /* ===========================
     BASE ELEMENTS
     =========================== */
  html {
    background: var(--background);
    color: var(--foreground);
    overflow-y: scroll;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-sans);
    line-height: 1.7;
    max-width: 896px;
    margin: 0 auto;
    position: relative;
  }

  /* ===========================
     SELECTION
     =========================== */
  ::selection {
    background: var(--accent);
    color: var(--background);
  }

  ::-moz-selection {
    background: var(--accent);
    color: var(--background);
  }

  /* ===========================
     TYPOGRAPHY
     =========================== */
  h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
    line-height: 1.2;
    color: var(--foreground);
    user-select: none;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3rem);
    font-weight: 600;
    padding: 1.5rem 0;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-weight: 300;
    letter-spacing: 0.1em;
    text-align: center;
    padding: 1.5rem 0;
  }

  h3 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
  }

  h4 {
    font-size: 1.25rem;
    font-weight: 500;
  }

  h5 {
    font-size: 1.125rem;
    font-weight: 500;
  }

  p {
    font-size: 1.125rem;
    line-height: 1.75;
    opacity: var(--opacity-high);
  }

  /* ===========================
     LINKS
     =========================== */
  a {
    color: var(--foreground);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a:hover {
    color: var(--accent);
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Link with dashed underline (Ryze style) */
  .link {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 3px;
    transition: text-underline-offset var(--transition-fast);
  }

  .link:hover {
    text-underline-offset: 6px;
  }

  .link:active {
    color: var(--foreground);
  }

  /* ===========================
     BUTTONS
     =========================== */
  button {
    font-family: var(--font-sans);
    cursor: pointer;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .button {
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 0.5rem;
    padding: 0.25rem 0.75rem;
    letter-spacing: 0.025em;
    user-select: none;
    transition: all var(--transition-fast);
    display: inline-block;
    background: transparent;
    font-size: 1rem;
  }

  .button:hover {
    background: var(--accent);
    color: var(--background);
    font-weight: 600;
  }

  .button:active {
    border: none;
  }

  /* ===========================
     LAYOUT UTILITIES
     =========================== */
  .container {
    max-width: 768px;
    margin: 0 auto;
    padding-bottom: 3.25rem;
  }

  section {
    padding: 0.75rem 1.5rem;
  }

  /* ===========================
     DIVIDER
     =========================== */
  hr {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 3.25rem 0;
  }

  /* ===========================
     CARDS (Ryze style with hover)
     =========================== */
  .card {
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 1rem;
    transition: all var(--transition-fast);
  }

  .card:hover {
    border-color: var(--border-color-hover);
    transform: translateY(-2px);
  }

  /* ===========================
     SCROLLBAR
     =========================== */
  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background-color: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background-color: var(--foreground);
    border-radius: 3px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background-color: var(--accent);
  }

  /* Firefox scrollbar */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--foreground) transparent;
  }

  /* ===========================
     FORMS
     =========================== */
  input,
  textarea,
  select {
    font-family: var(--font-sans);
    color: var(--foreground);
    background: transparent;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--foreground);
    opacity: var(--opacity-low);
  }

  /* ===========================
     CODE BLOCKS
     =========================== */
  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: rgba(212, 212, 216, 0.1);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    border: 1px solid var(--border-color);
  }

  pre {
    font-family: var(--font-mono);
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--accent);
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  pre code {
    background: none;
    border: none;
    padding: 0;
  }

  /* ===========================
     TABLES
     =========================== */
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
  }

  th, td {
    padding: 0.75rem;
    text-align: left;
    border: 1px solid var(--border-color);
  }

  th {
    background: rgba(212, 212, 216, 0.05);
    font-weight: 600;
  }

  /* ===========================
     LISTS
     =========================== */
  ul, ol {
    padding-left: 2rem;
    margin: 1rem 0;
  }

  li {
    font-size: 1.125rem;
    line-height: 1.75;
    opacity: var(--opacity-high);
    margin: 0.5rem 0;
  }

  /* ===========================
     BLOCKQUOTES
     =========================== */
  blockquote {
    background: rgba(212, 212, 216, 0.05);
    border-left: 4px solid var(--accent);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    opacity: 0.9;
  }

  /* ===========================
     IMAGES & MEDIA
     =========================== */
  img {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 0.5rem;
  }

  figure {
    margin: 2rem 0;
  }

  figcaption {
    font-size: 0.875rem;
    opacity: var(--opacity-medium);
    margin-top: 0.5rem;
    text-align: center;
  }

  /* ===========================
     RESPONSIVE DESIGN
     =========================== */
  @media (max-width: 768px) {
    body {
      max-width: 100%;
    }

    h1 {
      font-size: 2rem;
      padding: 1rem 0;
    }

    h2 {
      font-size: 1.5rem;
      padding: 1rem 0;
    }

    section {
      padding: 0.75rem 1rem;
    }

    .container {
      padding-bottom: 2rem;
    }

    hr {
      margin: 2rem 0;
    }

    p, li {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 1.75rem;
    }

    h2 {
      font-size: 1.25rem;
    }

    section {
      padding: 0.5rem 0.75rem;
    }
  }

  /* ===========================
     UTILITY CLASSES
     =========================== */
  .text-accent {
    color: var(--accent);
  }

  .text-muted {
    opacity: var(--opacity-medium);
  }

  .font-mono {
    font-family: var(--font-mono);
  }

  .uppercase {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .user-select-none {
    user-select: none;
  }

  /* ===========================
     ANIMATIONS
     =========================== */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.3s ease-in-out;
  }

  /* ===========================
     ACCESSIBILITY
     =========================== */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Focus styles for keyboard navigation */
  *:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Reduced motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
